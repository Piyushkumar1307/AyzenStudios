# Used by Netlify when publish root is static/ (Git deploy + drag-and-drop).
# Keep only asset/icon rewrites, not page aliases that trigger redirect warnings in Search Console.

/static/*           /:splat              200
/assets/*           /assets/:splat        200
/css/*              /css/:splat           200
/js/*               /js/:splat           200
/favicon.ico        /favicon.svg         200
